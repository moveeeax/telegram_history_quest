# Скопируйте этот файл в .env и впишите свой токен.
# .env перечислен в .gitignore и .dockerignore — не коммитьте его и не
# добавляйте токен в bot.py.

# Telegram Bot Token
# Получите токен от @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Опциональные настройки
# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Каталог с файлами этапов квеста
TASKS_DIR=tasks
